{
  "manifest_version": 3,
  "name": "Video App Linker",
  "version": "1.0",
  "description": "Send video URLs to Video Downloader App",
  "permissions": ["declarativeNetRequest", "webRequest", "tabs", "activeTab", "storage", "cookies"],
  "host_permissions": [
    "<all_urls>",
    "*://*.surrit.com/*",
    "*://*.missav.com/*",
    "*://*.missav123.com/*",
    "http://127.0.0.1:8888/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
